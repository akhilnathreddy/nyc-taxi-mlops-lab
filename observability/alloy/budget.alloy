// Your series budget (S5, decision 014). Every series from this host passes through one of these three
// before it's sent. Grafana Cloud's free tier allows 10,000 active series for all hosts together
// (contracts/metrics.yaml). With no rules, everything is sent.
//
// Lean budget: keep what the dashboard, the SLOs (observability/slo.yaml) or an incident would use, by
// name (a keep list, so a new exporter metric costs nothing until someone asks for it), and drop every
// label whose value changes on each deploy, so a deploy reuses its colour's series instead of adding new ones.
//
// Rules are Prometheus relabelling (https://grafana.com/docs/alloy/latest/reference/components/prometheus/prometheus.relabel/):
//   rule { source_labels = ["__name__"]  regex = "node_(cpu|memory)_.*"  action = "keep" }
//   rule { regex = "id"  action = "labeldrop" }

declare "host" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// CPU (dashboard), memory, root disk space and I/O, network throughput, load, and whether the
		// scrape worked. Not kept: netstat, sockstat, softnet, xfs, timex and the exporter's own
		// node_scrape_collector_* (about 500 series per host, nothing a rider would notice).
		rule {
			source_labels = ["__name__"]
			regex         = "up|node_cpu_seconds_total|node_memory_(MemAvailable|MemTotal)_bytes|node_filesystem_(avail|size)_bytes|node_disk_(read|written)_bytes_total|node_disk_io_time_seconds_total|node_network_(receive|transmit)_bytes_total|node_load(1|5|15)"
			action        = "keep"
		}

		// Only the root filesystem (not /boot/efi, /run, /tmp): every mountpoint other than "/".
		rule {
			source_labels = ["__name__", "mountpoint"]
			regex         = "node_filesystem_[a-z_]+;/.+"
			action        = "drop"
		}

		// Only the real network interfaces: no loopback, Docker bridges or container veths.
		rule {
			source_labels = ["__name__", "device"]
			regex         = "node_network_[a-z_]+;(lo|docker.*|br-.*|veth.*)"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "containers" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// cAdvisor also reports the host's own cgroups (system.slice, ...), with no container name.
		rule {
			source_labels = ["__name__", "name"]
			regex         = "container_.+;"
			action        = "drop"
		}

		// Per container: CPU, memory (dashboard), out-of-memory kills, and its start time (a restart shows
		// as a jump). Not kept: the container_fs_* family, about 15 series per container per device.
		rule {
			source_labels = ["__name__"]
			regex         = "up|container_cpu_usage_seconds_total|container_memory_working_set_bytes|container_oom_events_total|container_start_time_seconds"
			action        = "keep"
		}

		// Labels that change on every deploy: the container's cgroup id, its image tag, and Docker
		// Compose's labels (config hash, image digest, ...). `name` (lab-app-app-blue-1) stays, so a
		// redeployed colour keeps the same series.
		rule {
			regex  = "id|image|container_label_.+"
			action = "labeldrop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "services" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// Everything in contracts/metrics.yaml (lab_*), Traefik's per-service requests and latency (S8's
		// canary compares serving-champion and serving-challenger on them) and its entrypoint request
		// count, and whether each scrape worked. Not kept: Python, Go and process runtime metrics, Traefik's
		// byte counters and entrypoint latency buckets.
		rule {
			source_labels = ["__name__"]
			regex         = "up|lab_.+|traefik_service_(requests_total|request_duration_seconds_(bucket|sum|count)|server_up)|traefik_entrypoint_requests_total"
			action        = "keep"
		}

		// prometheus_client's *_created series: a start timestamp per counter and histogram, unused by any query.
		rule {
			source_labels = ["__name__"]
			regex         = ".+_created"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}
